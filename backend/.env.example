# Copy to .env for local (non-Docker) development: `cp .env.example .env`
# Docker Compose supplies its own equivalent values directly in
# docker-compose.yml — this file is for running `uvicorn` on the host.
#
# Never commit a real .env file. Secrets belong in environment variables
# / your deployment platform's secret manager, never in source control.

ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg://compliance:compliance@localhost:5432/compliance

JWT_SECRET_KEY=replace-with-a-long-random-value-before-any-real-deployment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- S3 export ---
# Point at a local LocalStack container for demo/dev (see docker-compose.yml).
# For real AWS: remove S3_ENDPOINT_URL entirely and set real credentials
# (or better, rely on an IAM role/instance profile and omit the keys).
S3_BUCKET_NAME=compliance-reports
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- MongoDB: forensic trail of rejected ingestion rows (optional) ---
# Leave MONGO_URL unset to disable it: uploads work exactly the same, the
# GET /batches/{id}/rejections endpoint just answers 503.
# `docker compose up` provides a mongo service on host port 27018.
MONGO_URL=mongodb://compliance:compliance@localhost:27018/?authSource=admin
MONGO_DB_NAME=compliance
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000
# Rejected raw payloads expire after this many days (TTL index).
MONGO_REJECTION_TTL_DAYS=90

REPORTS_LOCAL_DIR=./report_exports

MAX_UPLOAD_SIZE_BYTES=26214400
MAX_TRANSACTIONS_PER_BATCH=200000

LOG_LEVEL=INFO
